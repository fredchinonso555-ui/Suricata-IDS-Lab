# ============================================================
# SURICATA LOCAL RULE EXAMPLES
# ============================================================
# Portfolio examples based on documented lab activities.
# Validate rule syntax and configuration before deployment.
# These are not claimed to be exact original terminal rules.
# ============================================================

alert icmp any any -> $HOME_NET any (msg:"LAB ICMP Traffic Detected"; sid:1000001; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"LAB TCP SYN Connection Detected"; flags:S; sid:1000002; rev:1;)

alert udp any any -> $HOME_NET any (msg:"LAB UDP Traffic Detected"; sid:1000003; rev:1;)

alert http any any -> $HOME_NET any (msg:"LAB HTTP GET Request Detected"; flow:established,to_server; http.method; content:"GET"; sid:1000004; rev:1;)

alert tcp any any -> $HOME_NET 22 (msg:"LAB SSH Traffic Detected"; flow:to_server; sid:1000005; rev:1;)

alert dns any any -> $HOME_NET 53 (msg:"LAB DNS Traffic Detected"; sid:1000006; rev:1;)
